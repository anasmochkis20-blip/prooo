{
  "version": 2,
  "builds": [
    {
      "src": "app1e/api/index.php",
      "use": "vercel-php@0.7.1",
      "config": {
        "includeFiles": [
          "app1e/api/apppp/**"
        ]
      }
    },
    {
      "src": "app1e/api/apppp/iclllll/res/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*\\.(css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf))",
      "dest": "/app1e/api/apppp/iclllll/$1"
    },
    {
      "src": "/res/(.*)",
      "dest": "/app1e/api/apppp/iclllll/res/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/app1e/api/index.php"
    }
  ]
}
